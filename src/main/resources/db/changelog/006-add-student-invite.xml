<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-1-add-student-invite" author="akusher">
        <addColumn tableName="student_profiles">
            <column name="invite_token" type="VARCHAR(255)">
                <constraints unique="true" uniqueConstraintName="uq_student_profiles_invite_token"/>
            </column>
            <column name="invite_token_expires_at" type="TIMESTAMP WITH TIME ZONE"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>

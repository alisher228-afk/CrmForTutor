<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-1-create-tests" author="akusher">
        <createTable tableName="tests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_tests" nullable="false"/>
            </column>
            <column name="tutor_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_tests_tutor" references="users(id)"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="topic" type="VARCHAR(100)"/>
            <column name="type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="external_url" type="VARCHAR(1024)"/>
            <column name="questions_json" type="TEXT"/>
            <column name="time_limit_minutes" type="INTEGER"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="tests" indexName="idx_tests_tutor_id">
            <column name="tutor_id"/>
        </createIndex>

        <createIndex tableName="tests" indexName="idx_tests_topic">
            <column name="tutor_id"/>
            <column name="topic"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
